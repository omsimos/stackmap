{
  "name": "@omsimos/stackmap",
  "version": "0.6.0",
  "description": "Interactive system diagrams your coding agent writes, as one offline HTML file",
  "keywords": [
    "architecture",
    "diagram",
    "agent",
    "skill",
    "claude",
    "elk",
    "offline",
    "html",
    "dataflow",
    "workflow",
    "lifecycle",
    "sequence"
  ],
  "homepage": "https://stackmap.omsimos.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omsimos/stackmap.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/omsimos/stackmap/issues",
  "license": "MIT",
  "type": "module",
  "bin": {
    "stackmap": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node scripts/copy-template.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "bun run --filter @stackmap/viewer build && bun run build && node scripts/smoke.mjs",
    "e2e": "bun run --filter @stackmap/viewer build && bun run build && playwright test",
    "prepack": "bun run build && node scripts/prepack.mjs"
  },
  "dependencies": {
    "elkjs": "0.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@stackmap/core": "workspace:*",
    "@stackmap/layout": "workspace:*",
    "@stackmap/schema": "workspace:*",
    "@stackmap/viewer": "workspace:*",
    "tsup": "^8.5.1",
    "zod": "^4.6.5"
  }
}
