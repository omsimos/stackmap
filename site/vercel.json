{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd .. && bun install --frozen-lockfile",
  "buildCommand": "cd .. && bun run --filter @stackmap/viewer build && cd site && bun run build",
  "git": { "deploymentEnabled": { "main": false } },
  "ignoreCommand": "sh scripts/ignore-build.sh"
}
